<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Model.Efatura</RootNamespace>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>$(NoWarn);CS1591;NU1902</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>$(NoWarn);CS1591;NU1902</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model.Efatura.Domain.Shared\Model.Efatura.Domain.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.1" />
    <PackageReference Include="Volo.Abp.Emailing" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.Caching" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.Domain" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.AuditLogging.Domain" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Domain" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.BlobStoring.Database.Domain" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.OpenIddict.Domain" Version="10.1.0" />
    <PackageReference Include="Volo.Abp.Identity.Domain" Version="10.1.0" />
  </ItemGroup>

</Project>
